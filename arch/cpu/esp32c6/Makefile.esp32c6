### ESP32-C6 CPU Makefile

### Build options
SMALL ?= 0

### ESP-IDF integration
# Requires ESP-IDF to be installed and IDF_PATH set
ifeq ($(IDF_PATH),)
  $(info IDF_PATH not set - using minimal standalone mode)
  ESP_IDF_ENABLED = 0
else
  $(info Using ESP-IDF from $(IDF_PATH))
  ESP_IDF_ENABLED = 1
endif

### CPU-specific directories
CONTIKI_CPU_DIRS = . dev

### CPU source files (from dev directory)
CPU_SOURCES = clock-arch.c rtimer-arch.c uart-arch.c gpio-hal-arch.c esp32c6-radio.c sys-ctrl.c

### Startup code - add directly to source files
CONTIKI_SOURCEFILES += startup.S

### Add to CONTIKI_SOURCEFILES
CONTIKI_SOURCEFILES += $(CPU_SOURCES)

### Compiler definitions
CFLAGS += -DCPU_CONF_PATH=\"esp32c6-conf.h\"
CFLAGS += -DCPU_DEF_PATH=\"esp32c6-def.h\"

### Architecture flags for RISC-V
# ESP32-C6 uses RV32IMAC (32-bit RISC-V with integer, multiply, atomic, compressed)
CFLAGS += -march=rv32imac
CFLAGS += -mabi=ilp32
LDFLAGS += -march=rv32imac -mabi=ilp32

### ESP-IDF include paths and libraries
ifeq ($(ESP_IDF_ENABLED),1)
  # ESP-IDF component includes
  CFLAGS += -I$(IDF_PATH)/components/esp_rom/include
  CFLAGS += -I$(IDF_PATH)/components/esp_rom/include/esp32c6
  CFLAGS += -I$(IDF_PATH)/components/soc/esp32c6/include
  CFLAGS += -I$(IDF_PATH)/components/hal/esp32c6/include
  CFLAGS += -I$(IDF_PATH)/components/hal/include
  CFLAGS += -I$(IDF_PATH)/components/esp_hw_support/include
  CFLAGS += -I$(IDF_PATH)/components/esp_common/include
  CFLAGS += -I$(IDF_PATH)/components/esp_system/include
  CFLAGS += -I$(IDF_PATH)/components/newlib/platform_include
  CFLAGS += -I$(IDF_PATH)/components/riscv/include

  # Link against ESP-IDF ROM library for ets_printf etc
  LDFLAGS += -L$(IDF_PATH)/components/esp_rom/esp32c6/ld
  LDFLAGS += -T esp32c6.rom.ld
  LDFLAGS += -T esp32c6.rom.api.ld
  LDFLAGS += -T esp32c6.rom.newlib.ld
endif

### Optimization flags
ifeq ($(SMALL),1)
  CFLAGS += -Os
else
  CFLAGS += -O2
endif

### Warning flags
CFLAGS += -Wall -Wextra
CFLAGS += -Wno-unused-parameter
CFLAGS += -Wno-unused-function

### Target-specific flags
CFLAGS += -ffunction-sections -fdata-sections
LDFLAGS += -Wl,--gc-sections
LDFLAGS += -nostartfiles
LDFLAGS += -T $(LDSCRIPT)

### Linker script (simplified - would need actual linker script for ESP32-C6)
LDSCRIPT ?= $(CONTIKI_CPU)/esp32c6.ld


### Toolchain
# ESP32-C6 uses RISC-V GCC toolchain from ESP-IDF
PREFIX ?= riscv32-esp-elf

ifdef PREFIX
  CC       = $(PREFIX)-gcc
  CXX      = $(PREFIX)-g++
  LD       = $(PREFIX)-gcc
  AR       = $(PREFIX)-ar
  AS       = $(PREFIX)-as
  NM       = $(PREFIX)-nm
  OBJCOPY  = $(PREFIX)-objcopy
  OBJDUMP  = $(PREFIX)-objdump
  SIZE     = $(PREFIX)-size
  STRIP    = $(PREFIX)-strip
endif

### CPU-specific targets
.PHONY: esp32c6-info

esp32c6-info:
	@echo "ESP32-C6 CPU Configuration:"
	@echo "  CPU: RISC-V RV32IMAC @ 160 MHz"
	@echo "  RAM: 400 KB"
	@echo "  Flash: 8 MB (external)"
	@echo "  Radio: IEEE 802.15.4"
	@echo "  Toolchain: $(PREFIX)"

### Upload support using esptool.py
ESPTOOL ?= esptool.py
PORT ?= /dev/tty.usbserial*
BAUD ?= 460800

# Upload target - load directly to RAM and run (no flash, instant testing)
%.upload: $(BUILD_DIR_BOARD)/%.$(TARGET)
	$(ESPTOOL) --chip esp32c6 --port $(PORT) --baud $(BAUD) \
		load_ram $<

# Flash target - write to flash at app offset (requires bootloader at 0x0)
# First flash bootloader: idf.py -p PORT flash (from any ESP-IDF project)
%.flash: $(BUILD_DIR_BOARD)/%.$(TARGET)
	$(ESPTOOL) --chip esp32c6 elf2image --flash_mode dio --flash_size 8MB -o $(BUILD_DIR_BOARD)/$*.bin $<
	$(ESPTOOL) --chip esp32c6 --port $(PORT) --baud $(BAUD) \
		write_flash 0x10000 $(BUILD_DIR_BOARD)/$*.bin

# Login to serial console
.PHONY: login
login:
	python -m serial.tools.miniterm $(PORT) 115200
