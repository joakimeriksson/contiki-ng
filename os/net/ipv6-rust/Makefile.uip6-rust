# Makefile fragment for integrating uIP6-Rust with Contiki-NG
#
# Usage in your application Makefile:
#   include $(CONTIKI)/os/net/ipv6-rust/Makefile.uip6-rust

# Path to uIP6-Rust directory
UIP6_RUST_DIR = $(CONTIKI)/os/net/ipv6-rust

# Check if Rust stack is enabled
UIP6_RUST_ENABLED = 0
ifdef UIP6_RUST_CONF_ENABLE
  ifeq ($(UIP6_RUST_CONF_ENABLE),1)
    UIP6_RUST_ENABLED = 1
  endif
endif

# Only include Rust stack if explicitly enabled
ifeq ($(UIP6_RUST_ENABLED),1)

  $(info Building with Rust IPv6 stack)

  # Build the Rust library if not already built
  RUST_LIB = $(UIP6_RUST_DIR)/target/release/libuip6_rust.a

  # Rule to build Rust library
  $(RUST_LIB):
	@echo "Building Rust IPv6 library..."
	@cd $(UIP6_RUST_DIR) && cargo build --release

  # Include path for C header
  CFLAGS += -I$(UIP6_RUST_DIR)

  # Add configuration
  CFLAGS += -DUIP6_RUST_CONF_ENABLE=1
  CFLAGS += -DUIP_CONF_IPV6=1

  # Link with the Rust library
  TARGET_LIBFILES += $(RUST_LIB)

  # Add glue layer and Rust TCP/IP wrapper
  CONTIKI_SOURCEFILES += uip6-rust-glue.c tcpip-rust.c

  # Set source directory for glue code
  SOURCEDIRS += $(UIP6_RUST_DIR)

  # Exclude C IPv6 implementation files (Rust replaces these)
  # We now have buffer management and UDP in Rust, so we can exclude uip6.c
  MODULES_SOURCES_EXCLUDES += tcpip.c uip6.c
  # Note: We still keep some IPv6 helpers like uip-nd6.c, uip-ds6.c for now
  # as they provide functions that uip6.c would call

  # Clean target
  .PHONY: uip6-rust-clean
  uip6-rust-clean:
	@echo "Cleaning Rust IPv6 library..."
	@cd $(UIP6_RUST_DIR) && cargo clean

  clean: uip6-rust-clean

else
  $(info Building with C IPv6 stack (Rust disabled))
endif
